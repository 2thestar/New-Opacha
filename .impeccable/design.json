      "html": "<label class=\"ds-check\"><span>AI only</span><input class=\"ds-check-input\" type=\"checkbox\" /><svg class=\"ds-check-tick\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5.5 12 10.3 17 18.5 6.5\" fill=\"none\" stroke=\"#302A28\" stroke-width=\"1.56\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></label>",
      "css": ".ds-check{position:relative;display:flex;align-items:center;justify-content:space-between;width:292px;min-height:59.08px;font:600 19px Quicksand,sans-serif;color:#302A28}.ds-check-input{appearance:none;width:23.63px;height:23.63px;border:1.56px solid #302A28;border-radius:10.5px;background:#FCFBFA;margin:0}.ds-check-input:checked{background:#FED23F}.ds-check-tick{position:absolute;right:0;width:23.63px;height:23.63px;display:none;pointer-events:none}.ds-check-input:checked+.ds-check-tick{display:block}.ds-check-input:hover{cursor:pointer}.ds-check-input:focus-visible{outline:2px solid #302A28;outline-offset:3.51px}.ds-check:active{background:rgba(48,42,40,.2)}"
