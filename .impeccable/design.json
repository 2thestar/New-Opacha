      "html": "<label class=\"ds-slider\"><span class=\"ds-slider-title\">Level size</span><span class=\"ds-slider-value\">small</span><input class=\"ds-slider-input\" type=\"range\" min=\"0\" max=\"4\" value=\"1\" aria-label=\"Level size\" /></label>",
