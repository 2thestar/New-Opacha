      "html": "<button class=\"ds-primary\">Play</button>",
      "css": ".ds-primary{font:600 23px Quicksand,sans-serif;color:#302A28;border:1.64px solid #302A28;border-radius:16px;min-height:63.3px;padding:8px 24px;box-shadow:.82px 3.12px 0 #302A28,1.64px 4.68px 0 rgba(48,42,40,.09);background:#FED23F}.ds-primary:hover{cursor:pointer}.ds-primary:focus-visible{outline:2px solid #302A28;outline-offset:3.51px}.ds-primary:active{transform:translateY(2.34px);box-shadow:.82px .78px 0 #302A28,1.64px 4.68px 0 rgba(48,42,40,.09);background-image:linear-gradient(rgba(48,42,40,.07),rgba(48,42,40,.07))}"
